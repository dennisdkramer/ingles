{
  // Starts `node qa/notes.mjs` with the folder, so the two preview pages are always served and
  // every qa-note box writes itself straight into its .html file (Ctrl+S on a served page saves
  // every box). Run by hand with Ctrl+Shift+B, or stop it from the "notes server" terminal.
  "version": "2.0.0",
  "tasks": [
    {
      "label": "notes server — node qa/notes.mjs",
      "type": "shell",
      "command": "node qa/notes.mjs",
      "isBackground": true,
      "runOptions": {
        "runOn": "folderOpen"
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": false,
        "clear": true
      },
      "problemMatcher": [],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    }
  ]
}
