{
  "name": "ingles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ingles Abre Portas - static English-lessons site (GitHub Pages) plus its QA harnesses.",
  "scripts": {
    "build:lessons": "node build-lessons.mjs",
    "build:check": "node build-lessons.mjs --check",
    "qa": "node qa/run.mjs",
    "qa:check": "node qa/run.mjs check",
    "qa:games": "node qa/run.mjs games",
    "qa:live": "node qa/run.mjs live",
    "qa:liquid": "node qa/run.mjs liquid",
    "qa:rowctx": "node qa/run.mjs rowctx",
    "qa:rows3": "node qa/run.mjs rows3",
    "build:dict": "node build-dictionary.mjs",
    "mapcheck": "node qa/mapcheck.mjs",
    "batchcheck": "node qa/batchcheck.mjs",
    "batchcheck:self": "node qa/batchcheck.mjs --self-test",
    "saves": "node qa/watch-saves.mjs",
    "align": "node qa/align.mjs"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "jsdom": "30.1.2",
    "openai": "^7.45.1",
    "youtube-dl-exec": "^3.1.19"
  }
}
