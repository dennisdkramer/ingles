{
  "name": "ingles",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Ingles Abre Portas - static English-lessons site (GitHub Pages) plus its QA harnesses.",
  "scripts": {
    "build:lessons": "node build-lessons.mjs",
    "build:check": "node build-lessons.mjs --check",
    "qa": "node qa/run.mjs",
    "qa:games": "node qa/run.mjs games",
    "qa:layout": "node qa/run.mjs overflow --selftest && node qa/run.mjs overflow",
    "qa:live": "node qa/run.mjs live",
    "qa:liquid": "node qa/run.mjs liquid",
    "build:dict": "node build-dictionary.mjs"
  },
  "devDependencies": {
    "ffmpeg-static": "^5.3.0",
    "jsdom": "30.1.2",
    "openai": "^7.45.1",
    "youtube-dl-exec": "^3.1.19"
  }
}
